# Server-only. Copy to backend/.env. NEVER use VITE_ for API secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional for Claude keys requiring an explicit workspace:
ANTHROPIC_WORKSPACE_ID=
# Choose model IDs available in your provider account. These are editable starting points.
SS_OPENAI_MODEL=gpt-6-astra
SS_ANTHROPIC_MODEL=claude-opus-5-5
SS_ANTHROPIC_REVIEW_MODEL=claude-sonnet-5-5
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SS_API_TOKEN=
SS_DATA_DIR=./data
SS_MODELS_DIR=./models
SS_RENDER_IMAGE=scholarshorts-render:local
SS_JOB_TIMEOUT_SEC=3600
