FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg texlive-latex-base texlive-latex-extra texlive-fonts-recommended dvisvgm libpango1.0-dev libcairo2-dev pkg-config fonts-noto-cjk build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir manim==0.22.0 pydantic numpy scipy
COPY pipeline/render_kit /app/pipeline/render_kit
ENV PYTHONPATH=/app/pipeline HOME=/tmp
CMD ["manim", "--version"]
