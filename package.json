{
  "name": "scholarshorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "papers:sync": ".venv/bin/python scripts/collect_papers.py",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.md docs/*.md",
    "dev:api": ".venv/bin/python -m uvicorn app.api:app --app-dir backend --host 127.0.0.1 --port 8000",
    "dev:worker": "PYTHONPATH=backend .venv/bin/python -m app.worker",
    "test:backend": "PYTHONPATH=backend .venv/bin/python -m pytest backend/tests -q"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
